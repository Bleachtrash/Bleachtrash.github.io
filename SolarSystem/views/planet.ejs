<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=name%></title>
    <%- include('partials/includes.ejs')%>
        <link rel="stylesheet" href="style.css">
</head>

<body>
    <header>
        <h1>
            <%=name%>
        </h1>
        <%- include('partials/navbar.ejs')%>
    </header>
    <main>
        <div id="content">
        <img class="planet_img" src="<%=image%>" alt="<%=name%>">
            <p>
                <%=description%>
            </p>
            <p>Distance From Sun = <%=distanceFromSun%>
            </p>
            <p>Length of Year = <%=yearLength%>
            </p>
            <p>Radius = <%=radius%>
            </p>
            <a href="<%=websiteLink%>"><p>Website Link</p></a>
            <p>One Earth Day = <%=oneEarthDay%>
            </p>
            <p>Number of Moons = <%=moons%>
            </p>
        </div>
    </main>
    <footer>
        <%- include('partials/footer.ejs')%>
    </footer>
</body>

</html>