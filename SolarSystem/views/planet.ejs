<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=name%>
    </title>
    <%- include('partials/includes.ejs')%>
</head>

<body>
    <header>
        <h1>
            <%=name%>
        </h1>
        <%- include('partials/navbar.ejs')%>
    </header>
    <main>
        <div class="content">
            <div id="planet_info">
                <%if(name == "NASA Pod" && status == "bad"){%>
                    <h2>Unable to load data from NASA Pod!</h2>
                <%}else{%>
                    <div id="planet_info_left">
                        <%if(name == "NASA Pod"){%>
                            <img src="<%=url%>" alt="NASA Pod image">
                        <%} else{%>
                            <img src="<%=image%>" alt="<%=name%>">
                        <%}%>
                    </div>
                    <div id="planet_info_right">
                        <% if(name == "Asteroids" || name == "Comets"){%>
                            <p><%=def%></p>
                            <a href="<%link%>">Website</a>
                        <%} else if(name == "NASA Pod") {%>
                                <p><%=explanation%></p>
                        <%} else{%>
                            <p><%=description%></p>
                            <p><b>Radius</b> = <%=radius%></p>
                            <p><b>Distance From Sun</b> = <%=distanceFromSun%></p>
                            <p><b>Length of Year</b> = <%=yearLength%></p>
                            <p><b>Length of Day</b> = <%=oneEarthDay%></p>
                            <p><b>Number of Moons</b> = <%=moons%></p>
                            <a href="<%=websiteLink%>"><p>Website</p></a>
                        <%}%>
                    </div>
                <%}%>
            </div>
        </div>
    </main>
    <footer>
        <%- include('partials/footer.ejs')%>
    </footer>
</body>

</html>