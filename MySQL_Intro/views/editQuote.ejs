<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Edit quote</h1>
    <!-- Where you type in the quote -->
    <form action="/updateQuote" method="post">
        <label for="quoteInput">Quote</label>
        <input name="quote" id="quoteInput">
        
        <!-- Checks if there is a formErrors object 
             and if it has an entry for the user field  -->
        <% if (formErrors.quote) { %>
            <span class="form-error"><%= formErrors.quote %></span> 
        <% } %>

        <label for="authorInput">Author</label>
        <select name="authorId" id="authorInput">
            <% for (let author of formData.authors) { %>
                <option value="<%= author.authorId %>"><%= author.firstName %></option>
            <% } %>
        </select>
        <label for="categoriesInput">Category</label>
        <select name="categories" id="categoriesInput">
            <% for (let category of formData.categories) { %>
                <option value="<%= category.category %>"><%= category.category %></option>
            <% } %>
        </select>

        
        <label for="likesInput">Likes</label>
        <input name="likes" id="likesInput">
        
        <!-- Checks if there is a formErrors object 
             and if it has an entry for the user field  -->
        <% if (formErrors.likes) { %>
            <span class="form-error"><%= formErrors.likes %></span> 
        <% } %>
        <button>Update</button>
    </form>



</body>

</html>