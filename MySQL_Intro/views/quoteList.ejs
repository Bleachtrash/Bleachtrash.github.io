<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Quotes</h1>
    <% for (let quote of quotes)  { %>
        <div>
            <!-- Creates a link to the editQuote route -->
            <!-- narrowed down to the specific quote Id -->
            <!-- This route renders the edit form -->
            <a href="/editQuote?quoteId=<%= quote.quoteId %>">Update</a>
            <%= quote.quote %>
        </div>
    <% } %>
</body>
</html>